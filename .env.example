# SecureVault frontend configuration (Vite). Copy to .env.local and fill in real values.
# Never commit real values. Never place AWS secret keys or root credentials here.

# API Gateway invoke URL (base for all backend requests)
VITE_API_BASE_URL=

# AWS region that hosts the Cognito user pool, e.g. us-east-1
VITE_AWS_REGION=

# Cognito User Pool id, e.g. us-east-1_XXXXXXXXX
VITE_COGNITO_USER_POOL_ID=

# Cognito app client id (public; no client secret)
VITE_COGNITO_CLIENT_ID=

# Optional: Cognito Hosted UI domain. Reserved for future hosted-UI sign-in; not used yet.
VITE_COGNITO_DOMAIN=
